# Leave empty to run with the offline stub policy (no LLM, no cost).
GEMINI_API_KEY=
# Fallback chain: the next model is tried on 429 / 5xx / timeout.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_THINKING=low
# SQLite locally; a Neon Postgres URL in production.
DATABASE_URL=sqlite:///./agent_lab.db
# Optional: required header X-Admin-Token for POST /api/reset
ADMIN_TOKEN=
